# 승인 파일·원문은 바이트 단위 SHA-256으로 검증하므로 모든 OS에서 LF로 체크아웃
* text=auto eol=lf

*.py    text eol=lf diff=python
*.md    text eol=lf diff=markdown
*.txt   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.csv   text eol=lf
*.dl    text eol=lf
*.diff  text eol=lf -whitespace
*.html  text eol=lf diff=html
*.css   text eol=lf diff=css
*.js    text eol=lf

# Windows 전용 스크립트
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 바이너리
*.sqlite3 binary
*.db      binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.pptx    binary
*.zip     binary
